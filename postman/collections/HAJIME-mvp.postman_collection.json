{
  "info": {
    "_postman_id": "39d0757c-bbf4-474a-86fe-61e4e57d3700",
    "name": "HAJIME · Cierre funcional del MVP",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order against HAJIME Local. Creates fresh accounts/dojo/training/goals, then verifies edits, goal closure, password change and offline account recovery. Tokens/passwords/codes stay in the local run environment. Creates test data."
  },
