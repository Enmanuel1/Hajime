      "name": "01 · Registrar Director",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "register"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"hajime-director-{{$guid}}@example.test\", \"password\": \"Local test passphrase {{$guid}}\", \"displayName\": \"HAJIME Director\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const a=pm.response.json(); pm.environment.set(\"orgDirectorToken\",a.accessToken); pm.environment.set(\"orgDirectorUserId\",a.user.id);"
