{
  "info": {
    "_postman_id": "da41130a-2fa0-4deb-b395-92a40f5e6024",
    "name": "HAJIME · Dojos y miembros reales",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order against HAJIME Local. Creates three real test accounts and one dojo. Uses local environment tokens; no AWS/email. Each invitation is recipient-bound and accepted once."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "01 · Registrar Director",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "register"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"hajime-director-{{$guid}}@example.test\", \"password\": \"Local test passphrase {{$guid}}\", \"displayName\": \"HAJIME Director\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const a=pm.response.json(); pm.environment.set(\"orgDirectorToken\",a.accessToken); pm.environment.set(\"orgDirectorUserId\",a.user.id);"
            ]
          }
        }
      ]
    },
