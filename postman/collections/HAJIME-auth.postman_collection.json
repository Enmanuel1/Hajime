        {
          "name": "22 · Logout repetido es seguro",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/logout",
            "auth": {
              "type": "noauth"
