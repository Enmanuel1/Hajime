                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 409\",()=>pm.response.to.have.status(409));",
                  "pm.test(\"PROFILE_ALREADY_EXISTS\",()=>pm.expect(pm.response.json().code).to.eql(\"PROFILE_ALREADY_EXISTS\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "10 · No puedo asignarme un grado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/me/practitioner-profiles",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"martialArtCode\": \"JUDO\",\n  \"currentRankId\": \"12000000-0000-0000-0000-000000000007\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\",()=>pm.response.to.have.status(400));",
                  "pm.test(\"INVALID_REQUEST\",()=>pm.expect(pm.response.json().code).to.eql(\"INVALID_REQUEST\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "11 · Registrar entrenamiento personal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/me/training-sessions",
            "body": {
              "mode": "raw",
              "raw": "{{authTrainingBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set(\"authTrainingBody\",JSON.stringify({id:pm.variables.replaceIn(\"{{$guid}}\"),practitionerProfileId:pm.environment.get(\"authProfileId\"),occurredAt:new Date(Date.now()-3600000).toISOString(),durationMinutes:60,practiceType:\"TECHNICAL\",reflection:\"Entrenamiento con mi cuenta real.\",techniques:[],sparring:[]}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
                  "if(pm.response.code===201){pm.environment.set(\"authTrainingId\",pm.response.json().id);pm.test(\"PERSONAL\",()=>pm.expect(pm.response.json().source).to.eql(\"PERSONAL\"));}"
                ]
              }
            }
          ]
        },
        {
          "name": "12 · Leer mi entrenamiento",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/me/training-sessions/{{authTrainingId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "13 · Registro no me hace sensei",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/organizations/30000000-0000-0000-0000-000000000001/practitioners/{{authProfileId}}/goals",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Sin permiso\",\n  \"objective\": \"No debe guardarse\",\n  \"priority\": \"NORMAL\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\",()=>pm.response.to.have.status(403));",
                  "pm.test(\"ACCESS_DENIED\",()=>pm.expect(pm.response.json().code).to.eql(\"ACCESS_DENIED\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "14 · Renovar sesión y reemplazar tokens",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/refresh",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"authOldRefresh\",pm.environment.get(\"refreshToken\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                  "if(pm.response.code<300) {",
                  " const b=pm.response.json();",
                  " pm.environment.set(\"token\",b.accessToken);",
                  " pm.environment.set(\"refreshToken\",b.refreshToken);",
                  " pm.environment.set(\"authUserId\",b.user.id);",
                  " pm.test(\"Respuesta de sesión\",()=>{pm.expect(b.tokenType).to.eql(\"Bearer\");pm.expect(b.expiresIn).to.be.above(0);});",
                  " pm.test(\"No cache\",()=>pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\"));",
                  "}"
                ]
              }
            }
          ]
        },
